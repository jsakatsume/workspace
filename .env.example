# Copy this file to .env at the repository root and adjust paths for the host.

# Access mode for host data mounts: rw or ro.
MOUNT_ACCESS_MODE=ro

# Host-specific workspace data roots.
WORK_MOUNT_SOURCE=/work
WORK2_MOUNT_SOURCE=/work2
WORK3_MOUNT_SOURCE=/work3

# IMAGE_TAG, HOST_UID and HOST_GID are written automatically into .env by
# docker/sync-env.sh (via `make up`) — from the current git release tag and your
# host `id -u`/`id -g`. Do not set them by hand.
